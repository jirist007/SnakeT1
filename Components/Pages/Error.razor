@page "/Error"
@using System.Diagnostics

<PageTitle>Chyba</PageTitle>

<h1 class="text-danger">Chyba</h1>
<h2 class="text-danger">Při zpracování požadavku došlo k neočekávané chybě.</h2>
<p>Tato stránka slouží k informování, že aplikace narazila na problém a požadavek nebylo možné dokončit.</p>

@if (ShowRequestId)
{
    <p>
        <strong>ID požadavku:</strong> <code>@RequestId</code><br />
        Toto ID můžete předat podpoře pro snadnější dohledání chyby.
    </p>
}

<h3>Vývojový režim</h3>
<p>
    Přepnutí aplikace do prostředí <strong>Development</strong> zobrazí podrobnější informace o vzniklé chybě.
</p>
<p>
    <strong>V produkčním nasazení by prostředí Development nemělo být zapnuté.</strong>
    Může totiž koncovým uživatelům zobrazit citlivé informace z výjimek.
    Pro lokální ladění nastavte proměnnou prostředí <strong>ASPNETCORE_ENVIRONMENT</strong> na <strong>Development</strong>
    a aplikaci restartujte.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
